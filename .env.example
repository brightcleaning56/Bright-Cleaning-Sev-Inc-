# Copy to .env and replace every value before production.
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD_HASH=generate-with-npm-run-create-admin

# Email delivery is required for sending proposals and customer notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
NOTIFY_EMAIL=
